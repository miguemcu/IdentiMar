# Copia este archivo como .env y reinicia Expo (npx expo start -c).

# true: usa la implementación API (aún sin integrar, lanza error). false: datos simulados.
EXPO_PUBLIC_USE_API=false

# Solo con datos simulados: fuerza un error al enviar una observación.
# Valores: 400 | 401 | 413 | red. Vacío: sin error.
EXPO_PUBLIC_MOCK_ERROR=

# Solo con datos simulados: fuerza el resultado del modelo tras enviar.
# Valores: identificado | pendiente_experto | no_concluyente. Vacío: al azar.
EXPO_PUBLIC_MOCK_RESULTADO=
