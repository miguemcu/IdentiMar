# Copia este archivo como .env y reinicia Expo (npx expo start -c).

# true: usa la API real. false: datos simulados.
EXPO_PUBLIC_USE_API=false

# URL de la API (con https; con http el servidor redirige y un envío puede perderse).
EXPO_PUBLIC_API_URL=https://identimar-backend.onrender.com/api/v1

# Solo con datos simulados: fuerza un error.
# Al enviar una observación: 400 | 401 | 413 | 500.
# Sin conexión en toda la app (envío, catálogos, listado y detalle): red.
# Al registrarse: 409 (correo ya registrado) | 400-auth (dato inválido).
# Al elegir la foto: copia-foto (el teléfono no deja guardar la copia local).
# En la cola de envío: foto-ausente (la foto de lo guardado ya no está en el teléfono).
# Al enviar: tiempo-agotado (la observación se crea, pero la respuesta no llega; la cola
#   revisa si ya existe antes de reenviarla).
# Al seguir el resultado: 401-seguimiento (la segunda consulta del detalle da 401).
# En el detalle: imagen-vencida (la primera consulta de cada registro trae una foto que no carga)
#   | imagen-vencida-siempre (la foto nunca carga).
# En la ficha de especie: familias (el catálogo de familias no responde).
# En el perfil: perfil (GET /auth/perfil sin conexión) | 401-perfil (sesión vencida).
# En "Por validar": pendientes (sin conexión) | 403-pendientes (sin permiso).
# Al validar como experto: 403-validacion (sin permiso) | 409-validacion (ya no admite validación).
# El correo ya.registrado@ejemplo.co siempre da 409 al registrarse. Vacío: sin error.
EXPO_PUBLIC_MOCK_ERROR=

# Solo con datos simulados: fuerza el resultado del modelo tras enviar.
# Valores: identificado | pendiente_experto | no_concluyente. Vacío: al azar.
EXPO_PUBLIC_MOCK_RESULTADO=
